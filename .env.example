# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI (OpenRouter — unified provider for Claude, GPT, Gemini) ===
OPENROUTER_API_KEY=sk-or-v1-...

# === Atelier image AI (Cloudflare Workers AI — free daily allocation) ===
# Server-side only. Never prefix these variables with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token

# Maximum successful previews per user/IP during a rolling 24-hour window (1–20).
ATELIER_AI_DAILY_LIMIT=5

# Long random server-only value used to anonymize usage identifiers.
AI_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Optional comma-separated HTTPS hostnames for reference images outside your
# own Supabase project. Keep empty unless the host is fully trusted.
ATELIER_AI_REFERENCE_HOSTS=

# Keep the zero-key Pollinations fallback enabled unless explicitly set to false.
ATELIER_AI_PUBLIC_FALLBACK=true

# === Google Maps ===
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...

# === Web Push (VAPID) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# === CliQ (Jordan) ===
CLIQ_MERCHANT_ID=...
CLIQ_API_KEY=...
CLIQ_WEBHOOK_SECRET=...

# === Rate Limiting (Upstash Redis - مجاني للاستخدام الخفيف) ===
# These variables also make the Atelier daily quota atomic across serverless instances.
# Without them, the API keeps the backwards-compatible Supabase usage-log fallback.
UPSTASH_REDIS_REST_URL=...
UPSTASH_REDIS_REST_TOKEN=...

# === مراقبة الأخطاء (Sentry - اختياري، معطّل تلقائيًا إذا تُرك فارغًا) ===
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=962790000000
